# Copia este archivo a `.env` y rellena los valores reales.
#
#   cp .env.example .env
#
# `.env` está en `.gitignore` y **nunca** se sube al repo: aquí solo van las
# CLAVES, con valores de ejemplo. Los valores reales viven en el `.env` de cada
# entorno (local y Wasmer) y en `credenciales.md` (raíz del workspace, permisos
# 600).
#
# Arranque: `npm run dev` (compila y arranca `server.js` con este `.env`).

# ---------------------------------------------------------------- seguridad --

# Firma de los JWT. Obligatoria: sin ella el servidor no arranca
# (`requireEnv`). Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# No la rotes sin avisar: los tokens emitidos antes dejan de valer al instante.
AUTH_JWT_EXPIRES_IN=8h
AUTH_JWT_SECRET=

# ---------------------------------------------------------------- base datos --

# Cadena de conexión completa a Postgres (Supabase, Nhost o un Postgres local).
# Nhost: Dashboard → Database → Settings → Access; habilita el acceso público
# y copia la cadena que muestra. Ojo: guarda la contraseña entrecomillada o
# escapada si tiene símbolos.
DATABASE_URL=postgres://usuario:contraseña@host:5432/base

# SSL de la BD. `true` (o sin definir) = SSL, que es lo que exigen Supabase y
# Nhost; `false` = sin SSL, para un Postgres local sin certificados.
# DB_SSL=false

# CA del certificado de la BD (N-6): pem completo, con los BEGIN/END incluidos,
# escrito en una sola línea con \n. Si se define, la conexión pasa a
# `rejectUnauthorized: true` y solo se acepta un certificado firmado por esa CA.
# Si NO se define, se mantiene el comportamiento de siempre (`rejectUnauthorized:
# false`), que es el que usa el despliegue actual de Wasmer: no rompas ese
# despliegue poniéndola sin comprobar antes.
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# --------------------------------------------------------------- storage ----
# Proveedor de Storage: `supabase` (por defecto) o `nhost`.
# Ver NHOST.md para la prueba de conexión y los pasos en el dashboard.

STORAGE_PROVIDER=supabase

# --- Supabase Storage ---
SUPABASE_URL=https://proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Nhost Storage ---
# Base de la API de Storage, terminada en `/v1` (sin `/files`).
# Ejemplo: https://abcdefgh.storage.sa-east-1.nhost.run/v1
# NHOST_STORAGE_URL=
# Secreto de administración (Hasura admin secret) del proyecto.
# NHOST_ADMIN_SECRET=
# Opcional: un único bucket para todos los roles. Si falta se usan
# `delys`, `adc` y `domus`, que tienen que existir en Nhost.
# NHOST_BUCKET=default
# Opcional: base pública distinta (CDN propio) para las URLs de las fotos.
# NHOST_PUBLIC_URL_BASE=

# ---------------------------------------------------------------- red ---------

# Puerto HTTP del servidor (por defecto 3000).
# PORT=3000
